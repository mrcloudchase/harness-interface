[12.983938, "o", "\r\n\u001b[33msteer\u001b[0m POST /v1/sessions/{id}/interrupt -> 200\r\n\u001b[2mStop counting. Whether or not it finished, reply now with just the one word: stopped\u001b[0m\r\n"]
