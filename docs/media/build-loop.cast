[209.48135, "o", "\u001b[1m  diff --git a/switchboard/app.py b/switchboard/app.py\u001b[0m\r\n\u001b[2m  index 26e6869..798773e 100644\u001b[0m\r\n\u001b[1m  --- a/switchboard/app.py\u001b[0m\r\n\u001b[1m  +++ b/switchboard/app.py\u001b[0m\r\n\u001b[36m  @@ -1,5 +1,7 @@\u001b[0m\r\n\u001b[2m   import re\u001b[0m\r\n\u001b[31m  -from typing import List\u001b[0m\r\n\u001b[32m  +import subprocess\u001b[0m\r\n\u001b[32m  +import uuid\u001b[0m\r\n\u001b[32m  +from typing import List, Optional\u001b[0m\r\n\u001b[2m   from fastapi import FastAPI, HTTPException\u001b[0m\r\n\u001b[2m   from pydantic import BaseModel, Field, field_validator\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[36m  @@ -7,6 +9,8 @@ app = FastAPI()\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   # In-memory storage\u001b[0m\r\n\u001b[2m   harnesses_storage = {}\u001b[0m\r\n\u001b[32m  +runs_storage = {}\u001b[0m\r\n\u001b[32m  +runs_order = []\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   class Harness(BaseModel):\u001b[0m\r\n\u001b[36m  @@ -29,6 +33,23 @@ class Harness(BaseModel):\u001b[0m\r\n\u001b[2m           return v\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[32m  +class RunRequest(BaseModel):\u001b[0m\r\n\u001b[32m  +    harness: str\u001b[0m\r\n\u001b[32m  +    task: str\u001b[0m\r\n\u001b[32m  +    previous_run_id: Optional[str] = None\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +class Run(BaseModel):\u001b[0m\r\n\u001b[32m  +    id: str\u001b[0m\r\n\u001b[32m  +    harness: str\u001b[0m\r\n\u001b[32m  +    task: str\u001b[0m\r\n\u001b[32m  +    status: str\u001b[0m\r\n\u001b[32m  +    exit_code: Optional[int]\u001b[0m\r\n\u001b[32m  +    output: str\u001b[0m\r\n\u001b[32m  +    log: str\u001b[0m\r\n\u001b[32m  +    previous_run_id: Optional[str] = None\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[2m   @app.put(\"/harnesses/{name}\")\u001b[0m\r\n\u001b[2m   def put_harness(name: str, harness: Harness):\u001b[0m\r\n\u001b[2m       if harness.name != name:\u001b[0m\r\n\u001b[36m  @@ -55,3 +76,77 @@ def delete_harness(name: str):\u001b[0m\r\n\u001b[2m       if deleted:\u001b[0m\r\n\u001b[2m           del harnesses_storage[name]\u001b[0m\r\n\u001b[2m       return {\"deleted\": deleted}\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.post(\"/runs\")\u001b[0m\r\n"]
[209.481402, "o", "\u001b[32m  +def create_run(run_request: RunRequest):\u001b[0m\r\n\u001b[32m  +    # Validate harness exists\u001b[0m\r\n\u001b[32m  +    if run_request.harness not in harnesses_storage:\u001b[0m\r\n\u001b[32m  +        raise HTTPException(status_code=400, detail=\"harness not found\")\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Validate task is non-empty and non-whitespace\u001b[0m\r\n\u001b[32m  +    if not run_request.task or not run_request.task.strip():\u001b[0m\r\n\u001b[32m  +        raise HTTPException(status_code=400, detail=\"task must not be empty or whitespace\")\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    harness = harnesses_storage[run_request.harness]\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Generate unique run ID\u001b[0m\r\n\u001b[32m  +    run_id = f\"run_{uuid.uuid4().hex}\"\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Set up environment variables\u001b[0m\r\n\u001b[32m  +    env = {\u001b[0m\r\n\u001b[32m  +        \"TASK\": run_request.task,\u001b[0m\r\n\u001b[32m  +        \"SWITCHBOARD_TASK\": run_request.task\u001b[0m\r\n\u001b[32m  +    }\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Execute the command\u001b[0m\r\n\u001b[32m  +    try:\u001b[0m\r\n\u001b[32m  +        result = subprocess.run(\u001b[0m\r\n\u001b[32m  +            harness.command,\u001b[0m\r\n\u001b[32m  +            input=run_request.task,\u001b[0m\r\n\u001b[32m  +            capture_output=True,\u001b[0m\r\n\u001b[32m  +            text=True,\u001b[0m\r\n\u001b[32m  +            timeout=harness.timeout_s,\u001b[0m\r\n"]
[209.481537, "o", "\u001b[32m  +            env={**subprocess.os.environ.copy(), **env}\u001b[0m\r\n\u001b[32m  +        )\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +        status = \"completed\" if result.returncode == 0 else \"failed\"\u001b[0m\r\n\u001b[32m  +        exit_code = result.returncode\u001b[0m\r\n\u001b[32m  +        output = result.stdout\u001b[0m\r\n\u001b[32m  +        log = result.stderr\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    except subprocess.TimeoutExpired as e:\u001b[0m\r\n\u001b[32m  +        status = \"timeout\"\u001b[0m\r\n\u001b[32m  +        exit_code = None\u001b[0m\r\n\u001b[32m  +        output = e.stdout.decode() if e.stdout else \"\"\u001b[0m\r\n\u001b[32m  +        log = e.stderr.decode() if e.stderr else \"\"\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Create run object\u001b[0m\r\n\u001b[32m  +    run = Run(\u001b[0m\r\n\u001b[32m  +        id=run_id,\u001b[0m\r\n\u001b[32m  +        harness=run_request.harness,\u001b[0m\r\n\u001b[32m  +        task=run_request.task,\u001b[0m\r\n\u001b[32m  +        status=status,\u001b[0m\r\n\u001b[32m  +        exit_code=exit_code,\u001b[0m\r\n\u001b[32m  +        output=output,\u001b[0m\r\n\u001b[32m  +        log=log,\u001b[0m\r\n\u001b[32m  +        previous_run_id=run_request.previous_run_id\u001b[0m\r\n\u001b[32m  +    )\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Store run\u001b[0m\r\n\u001b[32m  +    runs_storage[run_id] = run\u001b[0m\r\n\u001b[32m  +    runs_order.append(run_id)\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    return run\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.get(\"/runs\")\u001b[0m\r\n\u001b[32m  +def list_runs():\u001b[0m\r\n\u001b[32m  +    return [runs_storage[run_id] for run_id in runs_order]\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.get(\"/runs/{id}\")\u001b[0m\r\n\u001b[32m  +def get_run(id: str):\u001b[0m\r\n\u001b[32m  +    if id not in runs_storage:\u001b[0m\r\n\u001b[32m  +        raise HTTPException(status_code=404, detail=\"run not found\")\u001b[0m\r\n\u001b[32m  +    return runs_storage[id]\u001b[0m\r\n"]
