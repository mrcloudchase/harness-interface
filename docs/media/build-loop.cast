ot be null\")\u001b[0m\r\n\u001b[32m  +        return v\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   @app.put(\"/harnesses/{name}\")\u001b[0m\r\n\u001b[2m   async def put_harness(name: str, harness: Harness):\u001b[0m\r\n\u001b[36m  @@ -38,8 +45,21 @@ async def put_harness(name: str, harness: Harness):\u001b[0m\r\n\u001b[2m       return harness\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[32m  +@app.get(\"/harnesses\")\u001b[0m\r\n\u001b[32m  +async def list_harnesses():\u001b[0m\r\n\u001b[32m  +    return sorted(harnesses_store.values(), key=lambda h: h.name)\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[2m   @app.get(\"/harnesses/{name}\")\u001b[0m\r\n\u001b[2m   async def get_harness(name: str):\u001b[0m\r\n\u001b[2m       if name not in harnesses_store:\u001b[0m\r\n\u001b[2m           raise HTTPException(status_code=404, detail=\"harness not found\")\u001b[0m\r\n\u001b[2m       return harnesses_store[name]\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.delete(\"/harnesses/{name}\")\u001b[0m\r\n\u001b[32m  +async def delete_harness(name: str):\u001b[0m\r\n\u001b[32m  +    if name in harnesses_store:\u001b[0m\r\n\u001b[32m  +        del harnesses_store[name]\u001b[0m\r\n\u001b[32m  +        return {\"deleted\": True}\u001b[0m\r\n\u001b[32m  +    return {\"deleted\": False}\u001b[0m\r\n"]
