[81.457783, "o", "\u001b[1m  diff --git a/switchboard/__init__.py b/switchboard/__init__.py\u001b[0m\r\n\u001b[2m  new file mode 100644\u001b[0m\r\n\u001b[2m  index 0000000..e69de29\u001b[0m\r\n\u001b[1m  diff --git a/switchboard/app.py b/switchboard/app.py\u001b[0m\r\n\u001b[2m  new file mode 100644\u001b[0m\r\n\u001b[2m  index 0000000..5aed42f\u001b[0m\r\n\u001b[1m  --- /dev/null\u001b[0m\r\n\u001b[1m  +++ b/switchboard/app.py\u001b[0m\r\n\u001b[36m  @@ -0,0 +1,57 @@\u001b[0m\r\n\u001b[32m  +import re\u001b[0m\r\n\u001b[32m  +from typing import List\u001b[0m\r\n\u001b[32m  +from fastapi import FastAPI, HTTPException\u001b[0m\r\n\u001b[32m  +from pydantic import BaseModel, Field, field_validator\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +app = FastAPI()\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +# In-memory storage\u001b[0m\r\n\u001b[32m  +harnesses_storage = {}\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +class Harness(BaseModel):\u001b[0m\r\n\u001b[32m  +    name: str\u001b[0m\r\n\u001b[32m  +    command: List[str]\u001b[0m\r\n\u001b[32m  +    timeout_s: float = 30\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    @field_validator(\"name\")\u001b[0m\r\n\u001b[32m  +    @classmethod\u001b[0m\r\n\u001b[32m  +    def validate_name(cls, v):\u001b[0m\r\n\u001b[32m  +        if not re.match(r\"^[a-z0-9][a-z0-9-]*$\", v):\u001b[0m\r\n\u001b[32m  +            raise ValueError(\"name must be lowercase letters, digits, and dashes, starting with letter or digit\")\u001b[0m\r\n\u001b[32m  +        return v\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    @field_validator(\"command\")\u001b[0m\r\n\u001b[32m  +    @classmethod\u001b[0m\r\n\u001b[32m  +    def validate_command(cls, v):\u001b[0m\r\n\u001b[32m  +        if not v or len(v) == 0:\u001b[0m\r\n\u001b[32m  +            raise ValueError(\"command must not be empty\")\u001b[0m\r\n\u001b[32m  +        return v\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.put(\"/harnesses/{name}\")\u001b[0m\r\n\u001b[32m  +def put_harness(name: str, harness: Harness):\u001b[0m\r\n\u001b[32m  +    if harness.name != name:\u001b[0m\r\n\u001b[32m  +        raise HTTPException(status_code=400, detail=\"name in body must match path parameter\")\u001b[0m\r\n\u001b[32m  +    harnesses_storage[name] = harness\u001b[0m\r\n\u001b[32m  +    return harness\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.get(\"/harnesses\")\u001b[0m\r\n\u001b[32m  +def list_harnesses():\u001b[0m\r\n\u001b[32m  +    return sorted(harnesses_storage.values(), key=lambda h: h.name)\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.get(\"/harnesses/{name}\")\u001b[0m\r\n\u001b[32m  +def get_harness(name: str):\u001b[0m\r\n\u001b[32m  +    if name not in harnesses_storage:\u001b[0m\r\n\u001b[32m  +        raise HTTPException(status_code=404, detail=\"harness not found\")\u001b[0m\r\n\u001b[32m  +    return harnesses_storage[name]\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.delete(\"/harnesses/{name}\")\u001b[0m\r\n\u001b[32m  +def delete_harness(name: str):\u001b[0m\r\n\u001b[32m  +    deleted = name in harnesses_storage\u001b[0m\r\n\u001b[32m  +    if deleted:\u001b[0m\r\n\u001b[32m  +        del harnesses_storage[name]\u001b[0m\r\n"]
