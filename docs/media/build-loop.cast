[229.713087, "o", "\u001b[1m  diff --git a/switchboard/app.py b/switchboard/app.py\u001b[0m\r\n\u001b[2m  index 2b34f80..06fe9ae 100644\u001b[0m\r\n\u001b[1m  --- a/switchboard/app.py\u001b[0m\r\n\u001b[1m  +++ b/switchboard/app.py\u001b[0m\r\n\u001b[36m  @@ -1,12 +1,15 @@\u001b[0m\r\n\u001b[2m   import re\u001b[0m\r\n\u001b[32m  +import subprocess\u001b[0m\r\n\u001b[32m  +import uuid\u001b[0m\r\n\u001b[2m   from fastapi import FastAPI, HTTPException\u001b[0m\r\n\u001b[2m   from pydantic import BaseModel, field_validator\u001b[0m\r\n\u001b[31m  -from typing import Union\u001b[0m\r\n\u001b[32m  +from typing import Union, Optional\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   app = FastAPI()\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   # In-memory storage\u001b[0m\r\n\u001b[2m   harnesses_store = {}\u001b[0m\r\n\u001b[32m  +runs_store = {}\u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   \u001b[0m\r\n\u001b[2m   class Harness(BaseModel):\u001b[0m\r\n\u001b[36m  @@ -63,3 +66,104 @@ async def delete_harness(name: str):\u001b[0m\r\n\u001b[2m           del harnesses_store[name]\u001b[0m\r\n\u001b[2m           return {\"deleted\": True}\u001b[0m\r\n\u001b[2m       return {\"deleted\": False}\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +class RunRequest(BaseModel):\u001b[0m\r\n\u001b[32m  +    harness: str\u001b[0m\r\n\u001b[32m  +    task: str\u001b[0m\r\n"]
[229.713741, "o", "\u001b[32m  +    previous_run_id: Optional[str] = None\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +class Run(BaseModel):\u001b[0m\r\n\u001b[32m  +    id: str\u001b[0m\r\n\u001b[32m  +    harness: str\u001b[0m\r\n\u001b[32m  +    task: str\u001b[0m\r\n\u001b[32m  +    status: str\u001b[0m\r\n\u001b[32m  +    exit_code: Optional[int]\u001b[0m\r\n\u001b[32m  +    output: str\u001b[0m\r\n\u001b[32m  +    log: str\u001b[0m\r\n\u001b[32m  +    previous_run_id: Optional[str]\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.post(\"/runs\")\u001b[0m\r\n\u001b[32m  +async def create_run(run_request: RunRequest):\u001b[0m\r\n\u001b[32m  +    # Validate harness exists\u001b[0m\r\n\u001b[32m  +    if run_request.harness not in harnesses_store:\u001b[0m\r\n\u001b[32m  +        raise HTTPException(status_code=400, detail=\"harness does not exist\")\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Validate task is not empty or whitespace\u001b[0m\r\n\u001b[32m  +    if not run_request.task or not run_request.task.strip():\u001b[0m\r\n\u001b[32m  +        raise HTTPException(status_code=400, detail=\"task is empty or only whitespace\")\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Validate previous_run_id if provided\u001b[0m\r\n\u001b[32m  +    previous_output = \"\"\u001b[0m\r\n\u001b[32m  +    if run_request.previous_run_id:\u001b[0m\r\n\u001b[32m  +        if run_request.previous_run_id not in runs_store:\u001b[0m\r\n\u001b[32m  +            raise HTTPException(status_code=400, detail=\"previous run does not exist\")\u001b[0m\r\n\u001b[32m  +        prev_run = runs_store[run_request.previous_run_id]\u001b[0m\r\n\u001b[32m  +        if prev_run.harness != run_request.harness:\u001b[0m\r\n\u001b[32m  +            raise HTTPException(status_code=400, detail=\"previous run belongs to another harness\")\u001b[0m\r\n\u001b[32m  +        previous_output = prev_run.output\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Generate unique run ID\u001b[0m\r\n\u001b[32m  +    run_id = f\"run_{uuid.uuid4().hex}\"\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Get harness\u001b[0m\r\n\u001b[32m  +    harness = harnesses_store[run_request.harness]\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Prepare environment variables\u001b[0m\r\n\u001b[32m  +    env = {\u001b[0m\r\n\u001b[32m  +        \"TASK\": run_request.task,\u001b[0m\r\n\u001b[32m  +        \"SWITCHBOARD_TASK\": run_request.task\u001b[0m\r\n\u001b[32m  +    }\u001b[0m\r\n\u001b[32m  +    if run_request.previous_run_id:\u001b[0m\r\n\u001b[32m  +        env[\"PREVIOUS_OUTPUT\"] = previous_output\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Execute command\u001b[0m\r\n\u001b[32m  +    try:\u001b[0m\r\n\u001b[32m  +        result = subprocess.run(\u001b[0m\r\n\u001b[32m  +            harness.command,\u001b[0m\r\n\u001b[32m  +            input=run_request.task,\u001b[0m\r\n\u001b[32m  +            capture_output=True,\u001b[0m\r\n\u001b[32m  +            text=True,\u001b[0m\r\n\u001b[32m  +            timeout=harness.timeout_s,\u001b[0m\r\n\u001b[32m  +            env={**subprocess.os.environ.copy(), **env}\u001b[0m\r\n\u001b[32m  +        )\u001b[0m\r\n\u001b[32m  +        status = \"completed\" if result.returncode == 0 else \"failed\"\u001b[0m\r\n\u001b[32m  +        exit_code = result.returncode\u001b[0m\r\n\u001b[32m  +        output = result.stdout\u001b[0m\r\n\u001b[32m  +        log = result.stderr\u001b[0m\r\n\u001b[32m  +    except subprocess.TimeoutExpired as e:\u001b[0m\r\n\u001b[32m  +        status = \"timeout\"\u001b[0m\r\n\u001b[32m  +        exit_code = None\u001b[0m\r\n"]
[229.713882, "o", "\u001b[32m  +        output = e.stdout.decode() if e.stdout else \"\"\u001b[0m\r\n\u001b[32m  +        log = e.stderr.decode() if e.stderr else \"\"\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Create run object\u001b[0m\r\n\u001b[32m  +    run = Run(\u001b[0m\r\n\u001b[32m  +        id=run_id,\u001b[0m\r\n\u001b[32m  +        harness=run_request.harness,\u001b[0m\r\n\u001b[32m  +        task=run_request.task,\u001b[0m\r\n\u001b[32m  +        status=status,\u001b[0m\r\n\u001b[32m  +        exit_code=exit_code,\u001b[0m\r\n\u001b[32m  +        output=output,\u001b[0m\r\n\u001b[32m  +        log=log,\u001b[0m\r\n\u001b[32m  +        previous_run_id=run_request.previous_run_id\u001b[0m\r\n\u001b[32m  +    )\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    # Store run\u001b[0m\r\n\u001b[32m  +    runs_store[run_id] = run\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +    return run\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.get(\"/runs\")\u001b[0m\r\n\u001b[32m  +async def list_runs():\u001b[0m\r\n\u001b[32m  +    return list(runs_store.values())\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +\u001b[0m\r\n\u001b[32m  +@app.get(\"/runs/{id}\")\u001b[0m\r\n\u001b[32m  +async def get_run(id: str):\u001b[0m\r\n\u001b[32m  +    if id not in runs_store:\u001b[0m\r\n\u001b[32m  +        raise HTTPException(status_code=404, detail=\"run not found\")\u001b[0m\r\n\u001b[32m  +    return runs_store[id]\u001b[0m\r\n"]
