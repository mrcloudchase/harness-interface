{
  "contract": 1,
  "name": "pi",
  "description": "pi 1.3.0 (earendil-works) over `pi --mode rpc`, steered mid-turn; Anthropic-, OpenAI chat- or Responses-shaped providers.",
  "provider": {"url": "https://api.anthropic.com", "api": "anthropic-messages"},
  "apis": ["anthropic-messages", "openai-chat", "openai-responses"],
  "install": {"egress": ["registry.npmjs.org"], "timeout_s": 600},
  "files": {".home/.pi/agent/AGENTS.md": "{instructions}"},
  "run": {"interrupt": "steered", "stdout": "application/x-ndjson", "timeout_s": 1800, "stop_timeout_s": 15,
          "credential": "gateway", "egress": []}
}
