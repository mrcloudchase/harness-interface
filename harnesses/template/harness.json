{
  "contract": 1,
  "name": "template",
  "description": "A stand-in CLI that counts with sleeps; proves the contract with no model.",
  "provider": {"url": "https://api.anthropic.com", "api": "anthropic-messages"},
  "apis": ["anthropic-messages", "openai-responses", "openai-chat"],
  "install": {"egress": ["registry.npmjs.org"], "timeout_s": 600},
  "files": {".home/.standin/AGENTS.md": "{instructions}"},
  "run": {"interrupt": "steered", "stdout": "application/x-ndjson", "timeout_s": 900, "stop_timeout_s": 15,
          "credential": "gateway", "egress": []},
  "report": [".standin/memory/**"]
}
