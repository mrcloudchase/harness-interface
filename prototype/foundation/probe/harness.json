{
  "name": "probe",
  "description": "No CLI: probes the network from the install and run containers (egress proofs).",
  "provider": {"url": "https://api.anthropic.com", "api": "anthropic-messages"},
  "apis": ["anthropic-messages", "openai-responses", "openai-chat"],
  "install": {"egress": ["registry.npmjs.org"], "timeout_s": 120},
  "files": {},
  "run": {"interrupt": "responded", "stdout": "application/x-ndjson", "timeout_s": 120, "stop_timeout_s": 5}
}
