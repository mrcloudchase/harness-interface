#!/usr/bin/env python3
"""A stand-in for the Docker CLI, for tests. Every call is appended to $DOCKER_CONFIG/calls as a JSON
list, each `run` client's own environment is kept in `<name>.client-env`, and each build's Dockerfile
in `build-<tag>`. A run's "container" is its command, run here as a plain process with only the
environment `-e` gives it, as Docker does; `kill` signals its process group, as tini does with
TINI_KILL_PROCESS_GROUP=1. A door keeps what it read on stdin in `<name>.stdin`, says it listens,
prints the lines of `door-log`, and waits to be removed. `image inspect -f` says an id and `amd64`.
Every container `run` makes and network `network create` makes is listed, with its `--label`s, in
`container-<name>.labels` or `network-<name>.labels` (a JSON list) until it is removed; `ps -aq` and
`network ls -q` print the names of those that match the `--filter`s (every `label=K=V`, any `name=REGEX`), so a
test may plant one. Knobs, as files in $DOCKER_CONFIG: `images` (tags already built), `arch`,
`fail-build`, `door-dead`, `kill-fails` (`kill` reaches nothing), `slow-create` (containers take a
while to appear)."""
import hashlib
import json
import os
import re
import signal
import sys
import time
from pathlib import Path

state = Path(os.environ["DOCKER_CONFIG"])     # the one setting of ours an allowlisted client keeps
args = sys.argv[1:]
with open(state / "calls", "a") as f:
    f.write(json.dumps(args) + "\n")
VALUED = {"--name", "--network", "--network-alias", "-e", "-v", "-w", "--user", "--tmpfs", "--pids-limit", "--memory",
          "--cap-drop", "--security-opt", "--signal", "--label", "--filter"}


def knob(name: str) -> bool:
    return (state / name).exists()


def images() -> list[str]:
    return (state / "images").read_text().split() if knob("images") else []


def value(flag: str) -> str:
    return args[args.index(flag) + 1]


def values(flag: str, among: list[str] | None = None) -> list[str]:
    among = args if among is None else among
    return [among[i + 1] for i, a in enumerate(among) if a == flag]


def make(kind: str, name: str, labels: list[str]) -> None:
    (state / f"{kind}-{name}.labels").write_text(json.dumps(labels))


def remove(kind: str, name: str) -> None:
    (state / f"{kind}-{name}.labels").unlink(missing_ok=True)


def listed(kind: str) -> list[str]:
    """The names of the containers or networks that match the filters, as Docker matches them: every
    label given, and any one of the names."""
    labels_ = [f.removeprefix("label=") for f in values("--filter") if f.startswith("label=")]
    names = [f.removeprefix("name=") for f in values("--filter") if f.startswith("name=")]
    found = []
    for p in sorted(state.glob(f"{kind}-*.labels")):
        name, labels = p.name[len(kind) + 1:-len(".labels")], json.loads(p.read_text())
        if all(label in labels for label in labels_) and (not names or any(re.search(n, name) for n in names)):
            found.append(name)
    return found


def split_run() -> tuple[list[str], list[str]]:
    """`run`'s options, and the image with its command."""
    i = 1
    while args[i].startswith("-"):
        i += 2 if args[i] in VALUED else 1
    return args[1:i], args[i:]


def signal_container(name: str, sig: int) -> None:
    pid = state / f"{name}.pid"
    if pid.exists():
        try:
            os.killpg(int(pid.read_text()), sig)
        except ProcessLookupError:
            pass


cmd = args[0]
if cmd == "image":                                   # image inspect [-f FORMAT] TAG: an id and an architecture
    if args[-1] not in images():
        sys.exit(1)
    if "-f" in args:
        arch = (state / "arch").read_text().strip() if knob("arch") else "amd64"
        print(f"sha256:{hashlib.sha256(args[-1].encode()).hexdigest()} {arch}")
    sys.exit(0)
if cmd == "build":                                   # build -t TAG -f - CONTEXT
    (state / f"build-{value('-t').replace(':', '-')}").write_text(sys.stdin.read())
    if knob("fail-build"):
        print("step 3/7: boom")
        sys.exit(1)
    with open(state / "images", "a") as f:
        f.write(value("-t") + "\n")
    print("built")
    sys.exit(0)
if cmd == "run":
    options, (image, *command) = split_run()
    name = options[options.index("--name") + 1]
    make("container", name, values("--label", options))
    (state / f"{name}.client-env").write_text(json.dumps(dict(os.environ)))
    (state / f"{name}.client-pid").write_text(str(os.getpid()))
    if knob("slow-create"):
        time.sleep(0.5)                              # the container is still being created: kill finds nothing
    (state / f"{name}.pid").write_text(str(os.getpid()))
    if name.startswith("hi-door-"):
        (state / f"{name}.stdin").write_text(sys.stdin.read())
        if knob("door-dead"):
            print("Error: the door's image is missing", flush=True)
            sys.exit(125)
        print("door listening", flush=True)
        if knob("door-log"):
            print((state / "door-log").read_text(), end="", flush=True)
        while True:
            time.sleep(1)
    env = {}
    for i, option in enumerate(options):
        if option == "-e":
            name_, _, given = options[i + 1].partition("=")
            if given or "=" in options[i + 1]:
                env[name_] = given
            elif name_ in os.environ:
                env[name_] = os.environ[name_]
    os.execvpe(command[0], command, {"PATH": os.environ["PATH"], **env})
if cmd == "kill":                                    # kill [--signal INT] NAME
    if knob("kill-fails") or not (state / f"{args[-1]}.pid").exists():
        print(f"Error response from daemon: cannot kill container: {args[-1]}: No such container")
        sys.exit(1)
    signal_container(args[-1], signal.SIGINT if "--signal" in args else signal.SIGKILL)
    sys.exit(0)
if cmd == "rm":                                      # rm -f NAME...: running containers are killed
    for name in args[2:]:
        signal_container(name, signal.SIGKILL)
        remove("container", name)
    sys.exit(0)
if cmd == "ps":                                      # ps -aq --filter F...
    print("\n".join(listed("container")))
    sys.exit(0)
if args[:2] == ["network", "ls"]:                    # network ls -q --filter F...
    print("\n".join(listed("network")))
    sys.exit(0)
if args[:2] == ["network", "create"]:                # network create --internal [--label L]... NAME
    make("network", args[-1], values("--label"))
if args[:2] == ["network", "rm"]:                    # network rm [-f] NAME...
    for name in args[2:]:
        if name != "-f":
            remove("network", name)
sys.exit(0)                                          # network create/connect/rm: succeed
