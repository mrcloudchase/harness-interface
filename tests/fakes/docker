#!/usr/bin/env python3
"""A stand-in for the Docker CLI, for tests. Every call is appended to $FAKE_DOCKER_DIR/calls as a
JSON list. A run's "container" is its command, run here as a plain process. Knobs, as files in
$FAKE_DOCKER_DIR: `images` (tags already built), `fail-build`, `slow-build`, `door-dead`,
`leftovers` (what `ps` and `network ls` report)."""
import json
import os
import signal
import sys
import time
from pathlib import Path

state = Path(os.environ["FAKE_DOCKER_DIR"])
args = sys.argv[1:]
with open(state / "calls", "a") as f:
    f.write(json.dumps(args) + "\n")


def knob(name: str) -> bool:
    return (state / name).exists()


def images() -> list[str]:
    return (state / "images").read_text().split() if knob("images") else []


cmd = args[0]
if cmd == "image":                                   # image inspect TAG
    sys.exit(0 if args[2] in images() else 1)
if cmd == "build":                                   # build -t TAG -f - CONTEXT
    sys.stdin.read()
    if knob("slow-build"):
        time.sleep(2)
    if knob("fail-build"):
        print("step 3/7: boom")
        sys.exit(1)
    with open(state / "images", "a") as f:
        f.write(args[2] + "\n")
    print("built")
    sys.exit(0)
if cmd == "logs":                                    # the door says it listens, unless it is dead
    if knob("door-dead"):
        print("Error: No such container")
        sys.exit(1)
    print("door listening")
    sys.exit(0)
if cmd == "run" and "-d" not in args:                # the run: everything after the image is its command
    image = next(a for a in args if a.startswith("harness-interface/"))
    name = args[args.index("--name") + 1]
    (state / f"{name}.pid").write_text(str(os.getpid()))
    command = args[args.index(image) + 1:]
    os.execvp(command[0], command)
if cmd == "kill":
    pid = state / f"{args[1]}.pid"
    if pid.exists():
        try:
            os.kill(int(pid.read_text()), signal.SIGKILL)
        except ProcessLookupError:
            pass
    sys.exit(0)
if cmd in ("ps", "network") and args[-1].startswith("name=") or args[:2] == ["network", "ls"]:
    if knob("leftovers"):
        print("leftover-1\nleftover-2")
    sys.exit(0)
sys.exit(0)                                          # network create/connect/rm, run -d (the door), rm: succeed
